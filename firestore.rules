rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Seul ce compte peut écrire dans medical_centers (seeding).
    // Remplace par l'UID Firebase Auth du compte de seeding.
    function isSeeder() {
      return isSignedIn() && request.auth.uid == 'REMPLACER_PAR_UID_SEEDER';
    }

    // Centres de santé : lecture pour tout utilisateur connecté,
    // écriture réservée au compte de seeding.
    match /medical_centers/{centerId} {
      allow read: if isSignedIn();
      allow write: if isSeeder();
    }

    // Profil utilisateur (pays, ville) : accessible uniquement à son propriétaire.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /vaccine_progress/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /cpn_progress/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /maternity_tasks/{documentId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /maternity_vaccines/{vaccineId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /maternity_cpn_schedules/{cpnId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}